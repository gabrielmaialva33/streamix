{
  "name": "streamix-assets",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "lint": "biome check js/",
    "lint:fix": "biome check --fix js/",
    "lint:openapi": "redocly lint",
    "format": "biome format --write js/",
    "test": "node --test js/test/*.test.js",
    "budget:assets": "cd .. && mix assets.deploy && cd assets && node js/smoke/asset_budget.cjs",
    "smoke:player": "node js/smoke/player_lifecycle_smoke.cjs",
    "smoke:mobile": "node js/smoke/mobile_browser_smoke.cjs",
    "smoke:pwa": "node js/smoke/pwa_first_install_smoke.cjs"
  },
  "dependencies": {
    "@libmedia/avplayer": "1.3.1",
    "avbridge": "^2.13.0",
    "hls.js": "^1.6.16",
    "mpegts.js": "^1.8.0"
  },
  "overrides": {
    "webworkify-webpack": "2.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@redocly/cli": "2.44.2",
    "playwright": "^1.62.0"
  },
  "patchedDependencies": {
    "webworkify-webpack@2.1.5": "patches/webworkify-webpack@2.1.5.patch"
  }
}
