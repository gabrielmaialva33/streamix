{
  "name": "streamix-assets",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "lint": "biome check ../",
    "lint:fix": "biome check --fix ../",
    "lint:openapi": "redocly lint",
    "format": "biome format --write js/",
    "test": "node --test --test-concurrency=4 \"js/test/**/*.test.js\"",
    "budget:assets": "cd .. && mix assets.deploy && cd assets && node js/smoke/asset_budget.cjs",
    "smoke:player": "node js/smoke/player_lifecycle_smoke.cjs",
    "smoke:mobile": "node js/smoke/mobile_browser_smoke.cjs",
    "smoke:pwa": "node js/smoke/pwa_first_install_smoke.cjs"
  },
  "dependencies": {
    "@libmedia/avplayer": "1.3.1",
    "avbridge": "^2.14.0",
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@redocly/cli": "^2.77.0",
    "playwright": "^1.64.1"
  }
}
