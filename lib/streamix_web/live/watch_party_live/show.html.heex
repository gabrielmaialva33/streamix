<div class="fixed inset-0 bg-black flex">
  <%!-- Video area --%>
  <div class={["flex-1 relative", @chat_open && "sm:mr-80"]}>
    <.video_player
      content={@content}
      content_type={@content_type}
      stream_url={@stream_url}
      streaming_mode={@streaming_mode}
      provider_type={@provider.provider_type}
      fullscreen={true}
      on_close="wp_leave"
      show_controls={true}
      next_episode={@next_episode}
      expected_duration={Map.get(@content, :duration_secs, 0) || 0}
    />

    <%!-- Watch Party Sync Hook --%>
    <div
      id="watch-party-sync"
      phx-hook="WatchPartySync"
      data-is-host={to_string(@is_host)}
      data-room-id={@room.id}
      class="hidden"
    />

    <%!-- Floating reactions container --%>
    <div id="wp-reactions-container" class="absolute bottom-20 right-4 pointer-events-none z-50" />

    <%!-- Watch Party floating controls — grouped into a single pill
         with a subtle backdrop so they read as one UI unit, not four
         loose buttons floating on top of the video. --%>
    <div class="absolute top-3 right-14 z-40 flex items-center gap-2 pl-2 pr-2 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/10 shadow-lg shadow-black/50">
      <.presence_indicators presences={@presences} />
      <div class="w-px h-6 bg-white/10" aria-hidden="true" />
      <.invite_badge invite_code={@room.invite_code} />
      <div class="w-px h-6 bg-white/10" aria-hidden="true" />

      <button
        phx-click="toggle_chat"
        aria-label="Abrir chat"
        class={[
          "relative w-9 h-9 rounded-full flex items-center justify-center transition-colors",
          @chat_open && "bg-purple-600 text-white shadow-md shadow-purple-600/40",
          !@chat_open && "text-white/80 hover:bg-white/10"
        ]}
        title="Abrir chat"
      >
        <.icon name="hero-chat-bubble-left-right" class="size-4" />
      </button>

      <button
        :if={@is_host}
        phx-click="wp_end_party"
        data-confirm="Encerrar a Watch Party para todos?"
        aria-label="Encerrar party"
        class="w-9 h-9 rounded-full bg-red-600/90 text-white flex items-center justify-center hover:bg-red-600 transition-colors shadow-md shadow-red-600/30"
        title="Encerrar party"
      >
        <.icon name="hero-x-mark" class="size-4" />
      </button>
    </div>

    <%!-- Host indicator --%>
    <div :if={!@is_host} class="absolute bottom-4 left-4 z-40">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-purple-600/80 text-white text-xs font-medium backdrop-blur-sm shadow-lg shadow-purple-600/30">
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inline-flex w-full h-full rounded-full bg-white opacity-60 animate-ping">
          </span>
          <span class="relative inline-flex w-1.5 h-1.5 rounded-full bg-white"></span>
        </span>
        Sincronizado com o host
      </span>
    </div>
  </div>

  <%!-- Chat sidebar --%>
  <.chat_sidebar
    :if={@chat_open}
    messages={@streams.messages}
    message_input={@message_input}
    room_id={@room.id}
  />
</div>
