<div
  id="watch-party-sync"
  phx-hook="WatchPartySync"
  data-is-host={to_string(@is_host)}
  data-room-id={@room.id}
  data-host-status={@host_status}
  data-server-state={@playback_state.state}
  data-server-position={@playback_state.position}
  data-server-buffering={to_string(Map.get(@playback_state, :host_buffering, false))}
  data-server-sequence={Map.get(@playback_state, :version, 0)}
  data-server-time={Map.get(@playback_state, :server_time)}
  class="fixed inset-0 flex h-[100dvh] w-[100dvw] overflow-hidden bg-black"
>
  <main class={["relative min-w-0 flex-1", @chat_open && "sm:mr-80"]}>
    <.video_player
      :if={is_binary(@stream_url)}
      content={@content}
      content_type={@content_type}
      stream_url={@stream_url}
      streaming_mode={@streaming_mode}
      provider_type={@provider.provider_type}
      fullscreen={true}
      on_close="wp_leave"
      show_controls={true}
      next_episode={@next_episode}
      expected_duration={Map.get(@content, :duration_secs, 0) || 0}
      subtitles_enabled={@current_scope.user.subtitles_enabled}
      subtitle_language={@current_scope.user.subtitle_language}
      subtitle_offset_ms={@current_scope.user.subtitle_offset_ms}
      party_mode={true}
      party_role={if @is_host, do: :host, else: :viewer}
    />

    <div
      :if={is_nil(@stream_url)}
      id="watch-party-player-reserving"
      class="absolute inset-0 flex items-center justify-center bg-black text-white"
      role="status"
      aria-live="polite"
    >
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="size-8 animate-spin rounded-full border-2 border-white/25 border-t-brand" />
        <p class="text-sm text-white/75">Reservando sua tela e preparando a reprodução...</p>
      </div>
    </div>

    <div
      id="wp-reactions-container"
      class="pointer-events-none absolute bottom-20 right-4 z-50"
      aria-hidden="true"
    />

    <div class="absolute right-14 top-3 z-40 flex items-center gap-2 rounded-full border border-white/10 bg-black/45 px-2 py-1.5 shadow-card backdrop-blur-md">
      <.presence_indicators presences={@presences} />
      <div class="h-6 w-px bg-white/10" aria-hidden="true" />
      <.invite_badge invite_code={@room.invite_code} />
      <div class="h-6 w-px bg-white/10" aria-hidden="true" />

      <button
        type="button"
        phx-click="toggle_chat"
        aria-label={if @chat_open, do: "Fechar chat", else: "Abrir chat"}
        aria-expanded={to_string(@chat_open)}
        aria-controls="watch-party-chat"
        class={[
          "relative flex size-9 items-center justify-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-brand",
          @chat_open && "bg-brand text-white shadow-md shadow-brand/30",
          !@chat_open && "text-white/80 hover:bg-white/10"
        ]}
      >
        <.icon name="hero-chat-bubble-left-right" class="size-4" />
        <span
          :if={@unread_messages > 0 and !@chat_open}
          class="absolute -right-1 -top-1 flex min-h-4 min-w-4 items-center justify-center rounded-full bg-error px-1 text-[10px] font-bold leading-none text-white"
          aria-label={"#{@unread_messages} mensagens não lidas"}
        >
          {min(@unread_messages, 99)}
        </span>
      </button>

      <button
        :if={@is_host}
        type="button"
        phx-click="wp_end_party"
        data-confirm="Encerrar a Watch Party para todos?"
        aria-label="Encerrar Watch Party"
        class="flex size-9 items-center justify-center rounded-full bg-error/90 text-white shadow-md shadow-error/30 transition-colors hover:bg-error focus:outline-none focus:ring-2 focus:ring-error"
      >
        <.icon name="hero-x-mark" class="size-4" />
      </button>
    </div>

    <div
      :if={show_sync_status?(@is_host, @host_status, @sync_status)}
      class="pointer-events-none absolute left-1/2 top-[calc(4.75rem+env(safe-area-inset-top,0px))] z-20 max-w-[calc(100vw-2rem)] -translate-x-1/2"
    >
      <span
        id="watch-party-sync-status"
        class={sync_status_class(@is_host, @host_status, @sync_status)}
        role="status"
        aria-live="polite"
      >
        <span class="relative flex size-1.5 flex-shrink-0">
          <span
            :if={@sync_status in ["synced", "correcting"] and @host_status == :online}
            class="absolute inline-flex size-full animate-ping rounded-full bg-current opacity-60"
          />
          <span class="relative inline-flex size-1.5 rounded-full bg-current" />
        </span>
        <span data-sync-status-text>
          {sync_status_text(@is_host, @host_status, @sync_status, @sync_drift_ms)}
        </span>
      </span>
    </div>
  </main>

  <.chat_sidebar
    :if={@chat_open}
    messages={@streams.messages}
    message_input={@message_input}
    room_id={@room.id}
    error={@chat_error}
  />
</div>
