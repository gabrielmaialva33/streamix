<div id="tv-guide" class="space-y-3 sm:space-y-4">
  <.page_header
    id="guide-page-header"
    title={gettext("Guia de TV")}
    icon="hero-calendar-days"
    subtitle={gettext("O que está passando agora e nas próximas horas, no horário de Brasília.")}
  >
    <:actions>
      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
        <button
          type="button"
          phx-click="shift_window"
          phx-value-direction="previous"
          class="guide-icon-button"
          aria-label={gettext("Mostrar programação anterior")}
        >
          <.icon name="hero-chevron-left" class="size-4" />
        </button>
        <button type="button" phx-click="go_now" class="guide-now-button">
          <span class="size-1.5 rounded-full bg-brand" aria-hidden="true" /> {gettext("Agora")}
          <span class="sr-only">{TvGuide.format_time(@now)}</span>
        </button>
        <button
          type="button"
          phx-click="shift_window"
          phx-value-direction="next"
          class="guide-icon-button"
          aria-label={gettext("Mostrar próxima programação")}
        >
          <.icon name="hero-chevron-right" class="size-4" />
        </button>
      </div>
    </:actions>
  </.page_header>

  <section class="guide-toolbar" aria-label={gettext("Filtros do guia")}>
    <div class="browse-toolbar__row">
      <.search_input
        id="guide-search-form"
        value={@search}
        placeholder={gettext("Buscar canais...")}
        on_change="filter"
        class="browse-toolbar__search"
      />

      <.provider_dropdown
        providers={@providers}
        selected={to_string(@selected_provider || "all")}
        on_change="filter_provider"
      />
    </div>

    <.filter_strip
      id="guide-category-strip"
      class="mt-2.5 sm:mt-3"
      role="group"
      aria-label={gettext("Categorias da programação")}
    >
      <.filter_chip
        active={@selected_category == "all"}
        label={gettext("Todos")}
        phx-click="filter_category"
        phx-value-category="all"
      />
      <button
        type="button"
        phx-click="toggle_favorites"
        aria-pressed={to_string(@favorites_only)}
        class={[
          "category-chip gap-1.5",
          @favorites_only && "category-chip--active"
        ]}
      >
        <.icon
          name={if @favorites_only, do: "hero-heart-solid", else: "hero-heart"}
          class="size-3.5"
        /> {gettext("Favoritos")}
      </button>
      <.filter_chip
        :for={category <- @categories}
        active={@selected_category == category}
        label={category}
        phx-click="filter_category"
        phx-value-category={category}
      />
    </.filter_strip>
  </section>

  <div class="flex items-baseline justify-between gap-3">
    <p id="guide-window" class="text-sm font-semibold text-text-primary tabular-nums">
      {TvGuide.window_label(@starts_at, @ends_at, @now)}
    </p>
    <p :if={!@loading} id="guide-count" class="text-xs text-text-muted">
      {ngettext(
        "%{count} canal com programação",
        "%{count} canais com programação",
        length(@visible)
      )}
    </p>
  </div>

  <div :if={@loading} id="guide-loading" class="space-y-2" aria-label={gettext("Carregando guia")}>
    <div
      :for={_ <- 1..6}
      class="grid gap-2 rounded-xl border border-border bg-surface/90 p-2.5 animate-pulse lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-3"
    >
      <div class="h-10 rounded-lg bg-surface-hover lg:h-14" />
      <div class="grid grid-cols-2 gap-1.5 lg:grid-cols-4">
        <div :for={_ <- 1..3} class="h-14 rounded-lg bg-surface-hover" />
      </div>
    </div>
  </div>

  <div :if={!@loading && @visible != []} id="guide-grid" class="guide-grid">
    <div class="guide-ruler" aria-hidden="true">
      <span class="guide-ruler__label">{LocalTime.day_label(@starts_at, @now)}</span>
      <div class="guide-ruler__track">
        <span
          :for={{tick, left} <- TvGuide.ticks(@starts_at, @ends_at)}
          class="guide-ruler__tick"
          style={"left: #{left}%"}
        >
          {TvGuide.format_time(tick)}
        </span>
      </div>
    </div>

    <ul
      id="guide-rows"
      phx-update="stream"
      phx-viewport-bottom={@shown < length(@visible) && "load_more"}
      class="guide-rows"
    >
      <li
        :for={{dom_id, row} <- @streams.guide_rows}
        id={dom_id}
        data-guide-row
        class="guide-row"
      >
        <div class="guide-channel">
          <.link
            href={~p"/watch/live_channel/#{row.channel.id}?return_to=/guide"}
            class="group flex min-w-0 flex-1 items-center gap-2.5"
          >
            <span class="guide-channel__logo">
              <img
                :if={row.logo}
                src={row.logo}
                alt=""
                class="size-full object-contain p-1"
                loading="lazy"
                decoding="async"
              />
              <.icon :if={!row.logo} name="hero-tv" class="size-5 text-text-muted" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-semibold leading-tight text-text-primary group-hover:text-brand">
                {row.channel.name}
              </span>
              <span class="mt-1 flex items-center gap-1.5 text-[11px] leading-none text-text-muted">
                <span class="truncate">{row.provider_name}</span>
                <span class="inline-flex shrink-0 items-center gap-0.5 font-medium text-brand">
                  <.icon name="hero-play-solid" class="size-3" /> {gettext("Assistir")}
                </span>
              </span>
            </span>
          </.link>

          <button
            type="button"
            phx-click="toggle_favorite"
            phx-value-id={row.channel.id}
            class={["guide-favorite-button", row.favorite? && "guide-favorite-button--on"]}
            aria-pressed={to_string(row.favorite?)}
            aria-label={
              if row.favorite?,
                do: gettext("Remover %{channel} dos favoritos", channel: row.channel.name),
                else: gettext("Adicionar %{channel} aos favoritos", channel: row.channel.name)
            }
          >
            <.icon
              name={if row.favorite?, do: "hero-heart-solid", else: "hero-heart"}
              class="size-4"
            />
          </button>
        </div>

        <div
          class="guide-timeline"
          aria-label={gettext("Programação de %{channel}", channel: row.channel.name)}
        >
          <div
            :for={program <- row.programs}
            style={program.style}
            data-guide-program
            data-state={program.state}
            data-current-program={to_string(program.state == :current)}
            class="guide-program"
            title={"#{TvGuide.format_time(program.start_time)}–#{TvGuide.format_time(program.end_time)} · #{program.title}"}
          >
            <div class="guide-program__body">
              <p class="guide-program__time">
                <span :if={program.state == :current} class="guide-program__live">
                  {gettext("No ar")}
                </span>
                <span class="tabular-nums">
                  {TvGuide.format_time(program.start_time)}–{TvGuide.format_time(program.end_time)}
                </span>
              </p>
              <p class="guide-program__title">{program.title}</p>
              <p :if={program.category} class="guide-program__category">{program.category}</p>
              <div :if={program.state == :current} class="guide-program__progress">
                <StreamixWeb.EpgComponents.epg_progress_bar program={program} />
              </div>
            </div>
          </div>
        </div>
      </li>
    </ul>

    <div
      :if={DateTime.compare(@now, @starts_at) != :lt && DateTime.compare(@now, @ends_at) == :lt}
      class="guide-now-overlay"
      aria-hidden="true"
    >
      <span
        class="guide-now-line"
        style={"left: #{StreamixWeb.EpgComponents.window_position(@now, @starts_at, @ends_at)}%"}
        aria-hidden="true"
      />
    </div>
  </div>

  <div :if={!@loading && @shown < length(@visible)} class="flex justify-center">
    <button
      id="guide-load-more"
      type="button"
      phx-click="load_more"
      class="guide-now-button"
    >
      {gettext("Mostrar mais canais")}
      <span class="text-text-muted tabular-nums">({length(@visible) - @shown})</span>
    </button>
  </div>

  <.empty_state
    :if={!@loading && @visible == []}
    id="guide-empty"
    icon="hero-calendar-days"
    title={gettext("Nenhum canal com programação")}
    message={
      gettext("Nada no guia nesta janela. Ajuste a busca e os filtros, ou volte para agora.")
    }
    cta_label={gettext("Explorar canais")}
    cta_navigate={~p"/browse"}
  />
</div>
