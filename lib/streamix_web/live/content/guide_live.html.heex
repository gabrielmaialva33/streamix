<div id="tv-guide" class="space-y-4 sm:space-y-6">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <.icon name="hero-calendar-days" class="size-6 text-brand" />
        <h1 class="text-2xl font-bold text-text-primary sm:text-3xl">{gettext("Guia de TV")}</h1>
      </div>
      <p class="mt-1 text-sm text-text-secondary">
        {gettext("Veja o que está passando agora e a programação das próximas horas.")}
      </p>
    </div>

    <div class="flex items-center gap-2 self-stretch sm:self-auto">
      <button
        type="button"
        phx-click="shift_window"
        phx-value-direction="previous"
        class="guide-icon-button"
        aria-label={gettext("Mostrar programação anterior")}
      >
        <.icon name="hero-chevron-left" class="size-4" />
      </button>
      <button type="button" phx-click="go_now" class="guide-now-button">
        <span class="size-1.5 rounded-full bg-brand" aria-hidden="true" /> {gettext("Agora")}
      </button>
      <button
        type="button"
        phx-click="shift_window"
        phx-value-direction="next"
        class="guide-icon-button"
        aria-label={gettext("Mostrar próxima programação")}
      >
        <.icon name="hero-chevron-right" class="size-4" />
      </button>
    </div>
  </header>

  <section class="guide-toolbar" aria-label={gettext("Filtros do guia")}>
    <form
      id="guide-filter-form"
      phx-change="filter"
      class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(12rem,18rem)]"
    >
      <label class="relative block">
        <span class="sr-only">{gettext("Buscar canal")}</span>
        <.icon
          name="hero-magnifying-glass"
          class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-text-muted"
        />
        <input
          type="search"
          name="search"
          value={@search}
          placeholder={gettext("Buscar canais…")}
          phx-debounce="350"
          class="guide-input pl-9"
        />
      </label>

      <label>
        <span class="sr-only">{gettext("Filtrar provedor")}</span>
        <select name="provider" class="guide-input">
          <option value="" selected={is_nil(@selected_provider)}>
            {gettext("Todos os provedores")}
          </option>
          <option
            :for={provider <- @providers}
            value={provider.id}
            selected={provider.id == @selected_provider}
          >
            {provider.name}
          </option>
        </select>
      </label>
    </form>

    <div class="filter-strip mt-3" role="group" aria-label={gettext("Categorias da programação")}>
      <button
        type="button"
        phx-click="filter_category"
        phx-value-category="all"
        class={["category-chip", @selected_category == "all" && "category-chip--active"]}
      >
        {gettext("Todos")}
      </button>
      <button
        :for={category <- @categories}
        type="button"
        phx-click="filter_category"
        phx-value-category={category}
        class={["category-chip", @selected_category == category && "category-chip--active"]}
      >
        {category}
      </button>
      <button
        type="button"
        phx-click="toggle_favorites"
        aria-pressed={@favorites_only}
        class={[
          "category-chip gap-1.5",
          @favorites_only && "category-chip--active"
        ]}
      >
        <.icon
          name={if @favorites_only, do: "hero-heart-solid", else: "hero-heart"}
          class="size-3.5"
        /> {gettext("Favoritos")}
      </button>
    </div>
  </section>

  <div class="flex items-center justify-between gap-3 text-xs text-text-muted">
    <p>
      {gettext("Janela:")}
      <span class="font-medium text-text-secondary">
        {TvGuide.window_label(@starts_at, @ends_at)}
      </span>
    </p>
    <p :if={!@loading}>{ngettext("%{count} canal", "%{count} canais", length(@rows))}</p>
  </div>

  <div :if={@loading} id="guide-loading" class="space-y-3" aria-label={gettext("Carregando guia")}>
    <div :for={_ <- 1..6} class="guide-row animate-pulse">
      <div class="h-16 rounded-lg bg-surface-hover" />
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        <div :for={_ <- 1..3} class="h-16 rounded-lg bg-surface-hover" />
      </div>
    </div>
  </div>

  <div :if={!@loading && @rows != []} id="guide-rows" class="space-y-2.5">
    <article :for={row <- @rows} id={"guide-channel-#{row.channel.id}"} class="guide-row">
      <div class="guide-channel">
        <.link
          href={~p"/watch/live_channel/#{row.channel.id}?return_to=/guide"}
          class="group flex min-w-0 flex-1 items-center gap-2.5"
        >
          <div class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-surface-hover">
            <img
              :if={ImageProxy.browser_image(row.channel.stream_icon)}
              src={ImageProxy.browser_image(row.channel.stream_icon)}
              alt=""
              class="size-full object-contain p-1"
              loading="lazy"
              decoding="async"
            />
            <.icon
              :if={!ImageProxy.browser_image(row.channel.stream_icon)}
              name="hero-tv"
              class="size-5 text-text-muted"
            />
          </div>
          <div class="min-w-0">
            <h2 class="truncate text-sm font-semibold text-text-primary group-hover:text-brand">
              {row.channel.name}
            </h2>
            <p class="truncate text-[10px] text-text-muted">{row.provider_name}</p>
            <span class="mt-1 inline-flex items-center gap-1 text-[10px] font-medium text-brand">
              <.icon name="hero-play-solid" class="size-3" /> {gettext("Assistir")}
            </span>
          </div>
        </.link>

        <button
          type="button"
          phx-click="toggle_favorite"
          phx-value-id={row.channel.id}
          class="guide-favorite-button"
          aria-label={
            if MapSet.member?(@favorite_ids, row.channel.id),
              do: gettext("Remover %{channel} dos favoritos", channel: row.channel.name),
              else: gettext("Adicionar %{channel} aos favoritos", channel: row.channel.name)
          }
        >
          <.icon
            name={
              if MapSet.member?(@favorite_ids, row.channel.id),
                do: "hero-heart-solid",
                else: "hero-heart"
            }
            class={[
              "size-4",
              MapSet.member?(@favorite_ids, row.channel.id) && "text-brand"
            ]}
          />
        </button>
      </div>

      <div
        class="guide-programs"
        aria-label={gettext("Programação de %{channel}", channel: row.channel.name)}
      >
        <div
          :for={program <- row.programs}
          data-current-program={
            if row.current_program && row.current_program.id == program.id,
              do: "true",
              else: "false"
          }
          class={[
            "guide-program",
            row.current_program && row.current_program.id == program.id &&
              "guide-program--current"
          ]}
        >
          <div class="flex items-center justify-between gap-2 text-[10px] text-text-muted">
            <span>
              {TvGuide.format_time(program.start_time)}–{TvGuide.format_time(program.end_time)}
            </span>
            <span :if={program.category} class="truncate">{program.category}</span>
          </div>
          <p class="mt-1 line-clamp-2 text-xs font-medium text-text-primary" title={program.title}>
            {program.title}
          </p>
          <StreamixWeb.EpgComponents.epg_progress_bar
            :if={row.current_program && row.current_program.id == program.id}
            program={program}
          />
        </div>

        <div :if={row.programs == []} class="guide-program guide-program--empty">
          <.icon name="hero-clock" class="size-4" /> {gettext(
            "Sem programação disponível nesta janela"
          )}
        </div>
      </div>
    </article>
  </div>

  <div :if={!@loading && @rows == []} class="surface-card py-14 text-center">
    <.icon name="hero-calendar-days" class="mx-auto size-10 text-text-muted" />
    <h2 class="mt-3 text-lg font-semibold text-text-primary">
      {gettext("Nenhum canal no guia")}
    </h2>
    <p class="mx-auto mt-1 max-w-md text-sm text-text-secondary">
      {gettext(
        "Ajuste os filtros ou sincronize o EPG do seu provedor para preencher a programação."
      )}
    </p>
    <.link
      navigate={~p"/browse"}
      class="mt-4 inline-flex min-h-11 items-center text-sm font-medium text-brand"
    >
      {gettext("Voltar aos canais")}
    </.link>
  </div>
</div>
