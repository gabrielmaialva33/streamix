<!DOCTYPE html>
<html lang={StreamixWeb.Locale.html_lang(assigns[:locale])}>
  <head>
    <meta charset="utf-8" />
    <%!--
      iOS Safari: viewport-fit=cover is required so env(safe-area-inset-*)
      values are non-zero on notched devices. `maximum-scale=1` removed so
      accessibility pinch-zoom works; to keep Safari from zooming on input
      focus we enforce font-size >= 16px on form controls via app.css.
    --%>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="format-detection" content="telephone=no, date=no, email=no, address=no" />

    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Streamix" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Streamix" />
    <meta name="msapplication-TileColor" content="#e50914" />
    <meta name="msapplication-TileImage" content="/images/icon-192.png" />

    <!-- PWA Manifest & Icons -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="apple-touch-icon-precomposed" href="/images/apple-touch-icon.png" />
    <link rel="mask-icon" href="/images/icon.svg" color="#e50914" />
    <link
      rel="apple-touch-startup-image"
      href="/images/pwa/splash-1290x2796.png"
      media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/images/pwa/splash-1179x2556.png"
      media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/images/pwa/splash-1170x2532.png"
      media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/images/pwa/splash-1125x2436.png"
      media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/images/pwa/splash-828x1792.png"
      media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/images/pwa/splash-750x1334.png"
      media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)"
    />
    <link rel="icon" type="image/svg+xml" href="/images/icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/icon-512.png" />

    <.live_title default="Streamix" suffix=" · Streamix">
      {assigns[:page_title]}
    </.live_title>

    <!-- Open Graph / Twitter Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Streamix" />
    <meta property="og:title" content={assigns[:page_title] || "Streamix"} />
    <meta
      property="og:description"
      content={
        assigns[:page_description] || "Filmes, séries e canais ao vivo — tudo em um só lugar."
      }
    />
    <meta :if={assigns[:og_image]} property="og:image" content={assigns[:og_image]} />
    <meta property="og:url" content={assigns[:og_url] || ""} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "Streamix"} />
    <meta
      name="twitter:description"
      content={
        assigns[:page_description] || "Filmes, séries e canais ao vivo — tudo em um só lugar."
      }
    />
    <meta :if={assigns[:og_image]} name="twitter:image" content={assigns[:og_image]} />
    <%!-- DNS hints are cheap; the actual TCP/TLS preconnect is emitted only
    for authenticated player routes by StreamixWeb.Router. --%>
    <link
      rel="dns-prefetch"
      href={Application.get_env(:streamix, :tmdb_proxy_url, "https://tmdb.mahina.cloud")}
    />
    <link rel="dns-prefetch" href="https://s4.anilist.co" />
    <link rel="dns-prefetch" href="https://cdn.tomatoanimes.com" />
    <link
      :if={assigns[:lcp_image]}
      rel="preload"
      as="image"
      href={@lcp_image}
      fetchpriority="high"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} fetchpriority="high" />
    <script
      defer
      phx-track-static
      type="module"
      src={~p"/assets/js/app.js"}
      nonce={assigns[:csp_nonce]}
    >
    </script>
    <script type="speculationrules" nonce={assigns[:csp_nonce]}>
      {"prefetch":[{"where":{"or":[{"href_matches":"/browse/*"},{"href_matches":"/gindex/*"}]},"eagerness":"moderate"}]}
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
