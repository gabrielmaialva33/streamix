<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    
<!-- PWA Meta Tags -->
    <meta name="theme-color" content="#e50914" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Streamix" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Streamix" />
    <meta name="msapplication-TileColor" content="#e50914" />
    <meta name="msapplication-TileImage" content="/images/icon.svg" />
    
<!-- PWA Manifest & Icons -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/images/icon.svg" />
    <link rel="icon" type="image/svg+xml" href="/images/icon.svg" />

    <.live_title default="Streamix" suffix=" · Streamix">
      {assigns[:page_title]}
    </.live_title>
    
<!-- Open Graph / Twitter Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Streamix" />
    <meta property="og:title" content={assigns[:page_title] || "Streamix"} />
    <meta
      property="og:description"
      content={
        assigns[:page_description] || "Filmes, séries e canais ao vivo — tudo em um só lugar."
      }
    />
    <meta :if={assigns[:og_image]} property="og:image" content={assigns[:og_image]} />
    <meta property="og:url" content={assigns[:og_url] || ""} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "Streamix"} />
    <meta
      name="twitter:description"
      content={
        assigns[:page_description] || "Filmes, séries e canais ao vivo — tudo em um só lugar."
      }
    />
    <meta :if={assigns[:og_image]} name="twitter:image" content={assigns[:og_image]} />
    <link
      rel="preconnect"
      href={Application.get_env(:streamix, :stream_proxy_url, "https://source.mahina.cloud")}
    />
    <link
      rel="preconnect"
      href={Application.get_env(:streamix, :tmdb_proxy_url, "https://tmdb.mahina.cloud")}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} fetchpriority="high" />
    <script
      defer
      phx-track-static
      type="module"
      src={~p"/assets/js/app.js"}
      nonce={assigns[:csp_nonce]}
    >
    </script>
    <script type="speculationrules">
      {"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/watch/*"}},{"not":{"href_matches":"/api/*"}},{"not":{"selector_matches":".no-prefetch"}}]},"eagerness":"moderate"}]}
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
