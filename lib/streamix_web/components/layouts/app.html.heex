<% banner_visible? = assigns[:provider_health] && @provider_health.show_banner? %>
<div class={["min-h-screen bg-background", if(banner_visible?, do: "pt-9", else: "")]}>
  <%!--
    Provider-health banner. Rendered by the StreamixWeb.OnMount.ProviderHealth
    hook via the @provider_health assign. Lives *above* the scroll-aware
    header (the header's `top` is shifted down by the banner's height via
    the `pt-9` on the wrapper + the header's conditional `top-9`) so the
    two never overlap — a previous version sat on top of the nav with a
    higher z-index and made the menu unclickable.
  --%>
  <%= if banner_visible? do %>
    <div
      role="status"
      aria-live="polite"
      class={[
        "fixed top-0 left-0 right-0 z-[60] h-9 flex items-center justify-center",
        "border-b px-4 text-xs sm:text-sm text-center leading-tight",
        if(@provider_health.status == :unhealthy,
          do: "bg-red-600 text-white border-red-700",
          else: "bg-amber-500 text-black border-amber-600"
        )
      ]}
    >
      <%= if @provider_health.status == :unhealthy do %>
        <span>
          <strong>Provedor IPTV indisponível.</strong>
          Alguns streams podem não tocar — estamos tentando reconectar.
        </span>
      <% else %>
        <span>
          <strong>Provedor IPTV instável.</strong>
          Alguns streams podem demorar mais que o normal para carregar.
        </span>
      <% end %>
    </div>
  <% end %>
  
<!-- Scroll-aware Header -->
  <header
    id="app-header"
    phx-hook="ScrollHeader"
    data-scrolled="false"
    class={[
      "fixed left-0 right-0 z-50 border-b border-transparent transition-all",
      if(banner_visible?, do: "top-9", else: "top-0")
    ]}
  >
    <div class="flex items-center justify-between h-14 sm:h-16 px-[4%]">
      <!-- Logo & Navigation -->
      <div class="flex items-center gap-4 sm:gap-8">
        <a
          href="/"
          class="flex items-center gap-1.5 sm:gap-2 text-xl sm:text-2xl font-bold text-brand"
        >
          <.icon name="hero-play-circle-solid" class="size-6 sm:size-8" />
          <span class="hidden sm:inline">Streamix</span>
        </a>

        <%= if @current_scope do %>
          <nav class="hidden md:flex items-center gap-1">
            <.nav_link
              path={~p"/"}
              label="Início"
              icon="hero-home"
              icon_active="hero-home-solid"
              active={@current_path == "/"}
            />
            <.nav_link
              path={~p"/browse"}
              label="Catálogo"
              icon="hero-film"
              icon_active="hero-film-solid"
              active={String.starts_with?(@current_path || "", "/browse")}
            />
            <.nav_link
              path={~p"/favorites"}
              label="Minha Lista"
              icon="hero-heart"
              icon_active="hero-heart-solid"
              active={@current_path == "/favorites"}
            />
            <.nav_link
              path={~p"/party"}
              label="Watch Party"
              icon="hero-users"
              icon_active="hero-users-solid"
              active={@current_path == "/party"}
              accent="purple"
            />
          </nav>
        <% end %>
      </div>
      
<!-- Right side: Search + User -->
      <div class="flex items-center gap-2 sm:gap-3">
        <%= if @current_scope do %>
          <!-- Search button (desktop) -->
          <.link
            navigate={~p"/search"}
            class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-hover/50 hover:bg-surface-hover text-text-secondary hover:text-text-primary transition-all text-sm"
          >
            <.icon name="hero-magnifying-glass" class="size-4" />
            <span class="text-text-muted">Buscar...</span>
            <kbd class="hidden lg:inline text-[10px] text-text-muted bg-surface px-1.5 py-0.5 rounded-md border border-border">
              /
            </kbd>
          </.link>
          
<!-- User avatar dropdown -->
          <div class="relative">
            <button
              type="button"
              class="flex items-center gap-2 p-1 rounded-xl hover:bg-surface-hover/50 transition-colors"
              phx-click={toggle_user_menu()}
            >
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand to-brand-hover flex items-center justify-center text-white text-sm font-semibold shadow-sm">
                {String.first(@current_scope.user.email) |> String.upcase()}
              </div>
            </button>

            <div
              id="user-dropdown"
              class="hidden absolute right-0 top-full mt-2 w-52 glass rounded-xl shadow-dropdown py-1.5 overflow-hidden"
            >
              <div class="px-4 py-2.5 border-b border-glass-border">
                <p class="text-sm font-medium text-text-primary truncate">
                  {@current_scope.user.email}
                </p>
              </div>
              <div class="py-1">
                <.dropdown_item navigate={~p"/history"} icon="hero-clock" label="Histórico" />
                <.dropdown_item
                  navigate={~p"/providers"}
                  icon="hero-server-stack"
                  label="Meus Provedores"
                />
                <.dropdown_item
                  navigate={~p"/settings"}
                  icon="hero-cog-6-tooth"
                  label="Configurações"
                />
                <.dropdown_item
                  :if={Streamix.Accounts.admin?(@current_scope.user)}
                  navigate={~p"/admin"}
                  icon="hero-shield-check"
                  label="Admin"
                />
              </div>
              <div class="border-t border-glass-border pt-1">
                <.link
                  href={~p"/logout"}
                  method="delete"
                  class="flex items-center gap-2.5 px-4 py-2 text-sm text-text-secondary hover:text-text-primary hover:bg-surface-hover/50 transition-colors"
                >
                  <.icon name="hero-arrow-right-on-rectangle" class="size-4" /> Sair
                </.link>
              </div>
            </div>
          </div>
        <% else %>
          <%= if @current_path not in ["/login", "/register"] do %>
            <div class="flex items-center gap-2">
              <.link
                navigate={~p"/login"}
                class="px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors rounded-xl"
              >
                Entrar
              </.link>
              <.link
                navigate={~p"/register"}
                class="px-4 py-2 text-sm font-semibold bg-brand text-white rounded-xl hover:bg-brand-hover transition-all shadow-sm hover:shadow-md"
              >
                Começar
              </.link>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </header>
  
<!-- Flash Messages (Toast style - top right) -->
  <div class="fixed top-[72px] right-4 z-50 w-full max-w-sm space-y-2">
    <.flash flash={@flash} kind={:info} />
    <.flash flash={@flash} kind={:error} />
  </div>
  
<!-- Main Content -->
  <main class="pt-14 sm:pt-16 pb-20 sm:pb-8 px-[4%]">
    {@inner_content}
  </main>
  
<!-- Bottom Navigation Bar (Mobile Only) -->
  <%= if @current_scope do %>
    <nav class="fixed bottom-0 left-0 right-0 z-40 md:hidden glass safe-area-bottom">
      <div class="flex items-center justify-around h-14">
        <.bottom_tab
          path={~p"/"}
          icon="hero-home"
          icon_active="hero-home-solid"
          label="Início"
          active={@current_path == "/"}
        />
        <.bottom_tab
          path={~p"/browse"}
          icon="hero-squares-2x2"
          icon_active="hero-squares-2x2-solid"
          label="Catálogo"
          active={String.starts_with?(@current_path || "", "/browse")}
        />
        <.bottom_tab
          path={~p"/search"}
          icon="hero-magnifying-glass"
          icon_active="hero-magnifying-glass-solid"
          label="Busca"
          active={@current_path == "/search"}
          center={true}
        />
        <.bottom_tab
          path={~p"/favorites"}
          icon="hero-heart"
          icon_active="hero-heart-solid"
          label="Lista"
          active={@current_path == "/favorites"}
        />
        <.bottom_tab
          path={~p"/settings"}
          icon="hero-user-circle"
          icon_active="hero-user-circle-solid"
          label="Perfil"
          active={@current_path == "/settings"}
        />
      </div>
    </nav>
  <% end %>
</div>
