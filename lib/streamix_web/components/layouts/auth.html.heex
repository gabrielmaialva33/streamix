<div
  id="client-telemetry"
  phx-hook="ClientTelemetry"
  class="grid lg:grid-cols-2 min-h-screen bg-background"
>
  <%!-- Form Panel --%>
  <div class="flex items-center justify-center p-6 sm:p-10 order-2 lg:order-1">
    <div class="w-full max-w-[380px]">
      <%!-- Flash Messages --%>
      <div
        :if={Phoenix.Flash.get(@flash, :info) || Phoenix.Flash.get(@flash, :error)}
        class="mb-6 space-y-2"
      >
        <.flash flash={@flash} kind={:info} />
        <.flash flash={@flash} kind={:error} />
      </div>

      {@inner_content}
    </div>
  </div>

  <%!-- Branded Panel (desktop only) --%>
  <div class="order-1 lg:order-2 auth-branded-panel relative rounded-2xl border border-white/[0.06] m-4 overflow-hidden auth-branded-bg">
    <%!-- Content --%>
    <div class="relative z-10 flex flex-col justify-between h-full p-10 xl:p-14">
      <%!-- Top: Logo --%>
      <.link href={~p"/"} class="inline-flex">
        <div class="flex items-center gap-2 text-xl font-bold text-brand">
          <.icon name="hero-play-circle-solid" class="size-8" />
          <span class="tracking-tight">Streamix</span>
        </div>
      </.link>

      <%!-- Center: Hero text --%>
      <div class="flex flex-col gap-4 max-w-sm">
        <h2 class="text-3xl xl:text-4xl font-bold text-white leading-tight tracking-tight">
          Seus conteúdos favoritos, em um só lugar.
        </h2>
        <p class="text-base text-white/60 leading-relaxed">
          Reúna todos os seus provedores IPTV em uma
          <span class="text-white/90 font-medium">interface cinematográfica</span>
          com busca inteligente e watch parties.
        </p>
      </div>

      <%!-- Bottom: Feature pills --%>
      <div class="flex flex-wrap gap-3">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.06] border border-white/[0.08] text-white/50 text-xs font-medium">
          <.icon name="hero-film" class="size-3.5" />
          <span>Catálogo unificado</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.06] border border-white/[0.08] text-white/50 text-xs font-medium">
          <.icon name="hero-users" class="size-3.5" />
          <span>Watch Party</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.06] border border-white/[0.08] text-white/50 text-xs font-medium">
          <.icon name="hero-magnifying-glass" class="size-3.5" />
          <span>Busca AI</span>
        </div>
      </div>
    </div>

    <%!-- Gradient overlay — strong at bottom for text, subtle at top to show image --%>
    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20"></div>
  </div>
</div>
