<div class="flex items-center justify-center min-h-screen bg-background px-6">
  <div class="flex flex-col items-center text-center max-w-md">
    <img
      src="/images/metronic/illustrations/20-dark.svg"
      alt="Erro interno"
      class="max-h-[180px] mb-8"
    />

    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-error/10 text-error border border-error/20 mb-4">
      500
    </span>

    <h1 class="text-2xl font-bold text-white mb-2">Algo deu errado</h1>

    <p class="text-text-secondary text-sm leading-relaxed mb-8">
      Ocorreu um erro interno no servidor. Tente novamente em alguns instantes.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand text-white text-sm font-semibold hover:bg-brand-hover transition-colors"
    >
      Voltar ao início
    </a>
  </div>
</div>
