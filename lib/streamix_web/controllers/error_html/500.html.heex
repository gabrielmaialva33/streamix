<main class="flex min-h-screen items-center justify-center bg-background px-6 text-text-primary">
  <div class="flex max-w-md flex-col items-center text-center">
    <div class="mb-5 flex size-16 items-center justify-center rounded-2xl border border-border bg-surface text-error shadow-card">
      <.icon name="hero-exclamation-triangle" class="size-8" />
    </div>

    <.badge variant="error" size="md" class="mb-3">500</.badge>

    <h1 class="mb-2 text-2xl font-bold text-text-primary sm:text-3xl">Algo deu errado</h1>

    <p class="mb-8 text-sm leading-relaxed text-text-secondary">
      Ocorreu um erro interno no servidor. Tente novamente em alguns instantes.
    </p>

    <.button navigate={~p"/"} variant="primary">
      <.icon name="hero-home" class="size-4" /> Voltar ao início
    </.button>
  </div>
</main>
