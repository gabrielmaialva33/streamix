{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "assets/js/**/*.js",
      "assets/js/smoke/**/*.cjs",
      "assets/js/smoke/**/*.mjs",
      "priv/sw.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noDebugger": "warn"
      },
      "style": {
        "noParameterAssign": "off",
        "useConst": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["assets/js/smoke/**/*.cjs", "assets/js/smoke/**/*.mjs"],
      "javascript": {
        "globals": ["process", "Buffer", "__dirname", "require", "module"]
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["priv/sw.js"],
      "javascript": {
        "globals": ["self", "caches", "clients"]
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
