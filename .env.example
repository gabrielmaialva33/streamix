# =============================================================================
# Streamix — Environment Variables
# Copy to .env and fill in: cp .env.example .env
# =============================================================================

# =============================================================================
# Phoenix / Server
# =============================================================================

# Enable the Phoenix server (required for releases)
PHX_SERVER=true

# HTTP port
PORT=4000

# Public hostname (production only, used for URL generation)
# PHX_HOST=streamix.example.com

# Secret key base — signs cookies and sessions
# Generate: mix phx.gen.secret
# REQUIRED in production
# SECRET_KEY_BASE=

# Dev-only secret key base. When set, keeps sessions stable across `mix phx.server`
# restarts. Optional — if unset, dev.exs generates a per-boot random key
# (you'll be logged out on every reload).
# DEV_SECRET_KEY_BASE=

# LiveView signing salt
# Generate: mix phx.gen.secret 32
# REQUIRED in production
# LIVE_VIEW_SIGNING_SALT=

# Distributed Erlang DNS cluster query (optional)
# DNS_CLUSTER_QUERY=

# Allowed WebSocket origins (optional, defaults to PHX_HOST)
# WEBSOCKET_ORIGINS=//streamix.example.com,//localhost

# =============================================================================
# Database (PostgreSQL 17 + TimescaleDB)
# =============================================================================

# Ecto database URL — format: ecto://USER:PASS@HOST:PORT/DATABASE
DATABASE_URL=ecto://streamix:streamix@localhost/streamix_dev

# Tests intentionally do not read this .env file. With no process-level
# overrides they use the local Compose streamix_test database. Export
# TEST_DATABASE_URL (or DATABASE_URL) in the shell/CI only when overriding it.
# TEST_DATABASE_URL=ecto://streamix:streamix@localhost/streamix_test
#
# Tests fail closed unless the host is localhost or the built-in Compose
# service (`postgres` / `streamix-postgres`). Export TEST_DATABASE_ALLOWED_HOSTS
# only for another local Compose service name.
#
# Intentional remote test databases require an exported TEST_DATABASE_URL with
# an `_test` database name plus the explicit opt-in below. Never point it at
# production data.
# ALLOW_REMOTE_TEST_DATABASE=i-know-this-is-a-test-database

# Connection pool size (default: 10, production recommended: 20+)
# POOL_SIZE=10

# IPv6 for database connections (set "true" if your DB requires it)
# ECTO_IPV6=false

# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://localhost:6379
# Tests ignore this .env value and default to localhost database 15. Export
# TEST_REDIS_URL in the shell/CI only to use alternate isolated test Redis.
# TEST_REDIS_URL=redis://localhost:6379/15

# =============================================================================
# Security / Encryption
# =============================================================================

# AES-256-GCM key for encrypting IPTV provider passwords at rest
# Generate: mix phx.gen.secret 32
# REQUIRED
PROVIDER_ENCRYPTION_KEY=

# =============================================================================
# Admin (seed user)
# =============================================================================

# Initial admin account created by mix ecto.seed
ADMIN_EMAIL=admin@streamix.local
ADMIN_PASSWORD=

# =============================================================================
# Global IPTV Provider (optional)
# A shared provider available to all users (browse mode)
# =============================================================================

GLOBAL_PROVIDER_ENABLED=false
# GLOBAL_PROVIDER_NAME=Streamix Global
# GLOBAL_PROVIDER_URL=http://provider.example.com
# GLOBAL_PROVIDER_USERNAME=
# GLOBAL_PROVIDER_PASSWORD=

# =============================================================================
# GIndex Provider (optional)
# Google Drive Index for movies/series/animes
# =============================================================================

GINDEX_ENABLED=false
# Ordered sync/listing pool. Keep the verified unified mirror first.
# GINDEX_ENDPOINTS=https://animezey16082023.animezey16082023.workers.dev/,https://1.animezey23112022.workers.dev/,https://1.animezeydl.workers.dev/
# GINDEX_SYNC_URL=https://animezey16082023.animezey16082023.workers.dev/
# GINDEX_STREAM_URL=https://animezey16082023.animezey16082023.workers.dev/
# Legacy configuration: uses one URL for both roles and appends built-in fallbacks.
# GINDEX_URL=https://my-gindex.workers.dev/
# Shared hard ceiling and capacity kept exclusively for interactive playback.
# GINDEX_DAILY_LIMIT=8000
# GINDEX_PLAYBACK_RESERVE=1000
# GINDEX_PAGE_DELAY_MS=5000
# GINDEX_PAGE_JITTER_MS=1000

# =============================================================================
# Torrent Provider / rqbit (optional)
# Aggregates torrent sources behind the global catalog. Requires rqbit sidecar.
# =============================================================================

TORRENT_ENABLED=false
# Phoenix running on host:
RQBIT_URL=http://localhost:3030
# Phoenix running inside compose:
# RQBIT_URL=http://rqbit:3030

# Optional normalized source feeds. Unset sources are skipped safely.
# EZTV_SOURCE_URL=http://localhost:4010/eztv
# GRATISTORRENT_SOURCE_URL=http://localhost:4010/gratistorrent
# COMANDOTORRENT_SOURCE_URL=http://localhost:4010/comandotorrent

# =============================================================================
# TMDB — The Movie Database (optional)
# Enriches metadata with posters, synopses, ratings, trailers
# Get your token: https://www.themoviedb.org/settings/api
# =============================================================================

# TMDB_API_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Optional: dedicated TMDB token used only by the GIndex ingestion pipeline,
# isolating its quota from the default. Falls back to TMDB_API_TOKEN when unset.
# GINDEX_TMDB_API_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# =============================================================================
# External Subtitles (optional)
# Searches PT-BR subtitles by IMDb id for torrent movies.
# OpenSubtitles is tried first, then SubDL as fallback.
# =============================================================================

# OpenSubtitles consumer credentials: https://opensubtitles.com/consumers
# OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USER_AGENT=Streamix v1

# SubDL API key: https://subdl.com/panel/api
# SUBDL_API_KEY=

# =============================================================================
# AI Embeddings / Semantic Search (optional)
# Powers vector-based content search via Qdrant
# =============================================================================

# Provider: "gemini" (3072 dims) or "nvidia" (1024 dims)
EMBEDDING_PROVIDER=gemini

# Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# NVIDIA NIM — https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_EMBEDDING_MODEL=nv-embedqa-e5-v5

# Qdrant vector database
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# =============================================================================
# Proxy URLs (CDN / Reverse Proxy)
# Nginx reverse proxies that solve HTTPS mixed-content blocking.
# Browsers block HTTP resources on HTTPS pages — these proxies terminate
# TLS and forward requests to upstream HTTP origins.
# =============================================================================

# IPTV stream proxy — relays HTTP provider streams over HTTPS
# Used by: player, stream controller, catalog API
STREAM_PROXY_URL=https://proxy.example.com

# TMDB image proxy — caches posters/backdrops from image.tmdb.org
# Used by: image_proxy helper, tmdb_client, catalog API
TMDB_PROXY_URL=https://tmdb-proxy.example.com

# imgmxa.net image proxy — some IPTV providers serve channel logos/thumbs here
# Used by: image_proxy helper, catalog API
IMGMXA_PROXY_URL=https://imgmxa-proxy.example.com

# Generic image proxy — catches any remaining HTTP image URLs
# Accepts ?url= param, proxies arbitrary HTTP images over HTTPS
# Used by: provider logos, gstaticontent images
IMAGE_PROXY_URL=https://image-proxy.example.com

# =============================================================================
# RabbitMQ / Broadway (optional)
# Distributed workers for heavy background processing
# When disabled, falls back to Oban (database-backed jobs)
# =============================================================================

RABBITMQ_ENABLED=false
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/
# BROADWAY_CONCURRENCY=1

# =============================================================================
# API / CORS
# =============================================================================

# API keys for TV app and external clients (comma-separated)
# Generate: mix phx.gen.secret 32
# API_KEYS=key1,key2
# IPTV_UPSTREAM_USER_AGENT=IPTVSmartersPlayer
# LIVE_MULTIPLEXER_ENABLED=true
# LIVE_MUX_IDLE_TIMEOUT_MS=2000
# LIVE_MUX_STREAM_IDLE_TIMEOUT_MS=45000

# Live admission control normally trusts the account's reported
# max_connections. Xtream providers frequently under-report it (an account
# that advertises 1 often serves several streams), which throttles playback
# for no reason. Set this to override the reported value.
# LIVE_CONNECTION_CEILING=3

# VOD block multiplexer: concurrent viewers of one title share upstream
# fetches per block, and cached blocks are served without touching the
# provider at all. VOD_CACHE_DIR defaults to a directory under the system
# temp dir; point it at persistent storage to keep the cache across deploys.
# VOD_MULTIPLEXER_ENABLED=false
# VOD_CONNECTION_CEILING=4
# VOD_BLOCK_SIZE_BYTES=4194304
# How much of the file an open-ended range (`bytes=0-`, which is what players
# send to start playback) is answered with. Serving the whole rest of the file
# pins one provider connection for the entire movie.
# VOD_OPEN_RANGE_WINDOW_BYTES=16777216
# VOD_READAHEAD_BLOCKS=1
# VOD_CACHE_DIR=/var/cache/streamix/vod
# VOD_CACHE_MAX_BYTES=21474836480

# Allowed CORS origins (comma-separated, omit for smart defaults)
# Dev default: localhost:4000, localhost:5173
# Prod default: https://$PHX_HOST
# NEVER use "*" in production
# CORS_ORIGINS=https://streamix.example.com,https://tv.example.com
