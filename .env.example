# =============================================================================
# Streamix Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Phoenix / Server
# -----------------------------------------------------------------------------

# Enable the Phoenix server (set to "true" for releases)
PHX_SERVER=true

# Port the HTTP server listens on
PORT=4000

# Public hostname for URL generation (used in prod)
# REQUIRED (production)
PHX_HOST=example.com

# Secret key base for signing cookies and sessions
# Generate with: mix phx.gen.secret
# REQUIRED (production)
SECRET_KEY_BASE=

# LiveView signing salt
# Generate with: mix phx.gen.secret 32
# REQUIRED (production)
LIVE_VIEW_SIGNING_SALT=

# DNS cluster query for distributed Erlang nodes (optional)
# DNS_CLUSTER_QUERY=

# Comma-separated list of allowed WebSocket origins (optional, defaults to PHX_HOST)
# WEBSOCKET_ORIGINS=//myapp.com,//localhost

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Full database URL
# REQUIRED (production)
# Format: ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=ecto://streamix:streamix@localhost/streamix_dev

# Connection pool size (default: 10)
POOL_SIZE=10

# Enable IPv6 for database connections (set to "true" or "1" if needed)
# ECTO_IPV6=false

# -----------------------------------------------------------------------------
# Security / Encryption
# -----------------------------------------------------------------------------

# AES-256-GCM key for encrypting provider passwords
# Generate with: mix phx.gen.secret 32
# REQUIRED
PROVIDER_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Global IPTV Provider (optional)
# Pre-configured provider available to all users
# -----------------------------------------------------------------------------

GLOBAL_PROVIDER_ENABLED=false
GLOBAL_PROVIDER_NAME=Streamix Global
GLOBAL_PROVIDER_URL=
GLOBAL_PROVIDER_USERNAME=
GLOBAL_PROVIDER_PASSWORD=

# -----------------------------------------------------------------------------
# TMDB - The Movie Database (optional)
# Enriches movie/series metadata with posters, descriptions, ratings
# Get your token at: https://www.themoviedb.org/settings/api
# -----------------------------------------------------------------------------

# TMDB_API_TOKEN=

# -----------------------------------------------------------------------------
# GIndex Provider (optional)
# Google Drive Index for movies/series/animes
# -----------------------------------------------------------------------------

GINDEX_ENABLED=false
GINDEX_URL=

# -----------------------------------------------------------------------------
# AI Embeddings / Semantic Search
# -----------------------------------------------------------------------------

# Embedding provider: "gemini" (default) or "nvidia"
EMBEDDING_PROVIDER=gemini

# Gemini API key (for embeddings with 3072 dimensions)
# Get yours at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# NVIDIA NIM API key (for embeddings with 1024 dimensions)
# NVIDIA_API_KEY=
# NVIDIA_EMBEDDING_MODEL=nv-embedqa-e5-v5

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# Required for semantic search functionality
# -----------------------------------------------------------------------------

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# RabbitMQ / Broadway (optional)
# Distributed workers for background processing
# When disabled, falls back to Oban for background jobs
# -----------------------------------------------------------------------------

RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Broadway processor concurrency (keep at 1 to avoid GIndex rate limiting)
BROADWAY_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Stream Proxy
# Reverse proxy for HTTP IPTV streams over HTTPS (mixed content fix)
# -----------------------------------------------------------------------------

STREAM_PROXY_URL=https://pannxs.mahina.cloud

# -----------------------------------------------------------------------------
# API Keys (optional)
# For TV app and external client authentication
# Comma-separated list of valid keys
# Generate with: mix phx.gen.secret 32
# -----------------------------------------------------------------------------

# API_KEYS=key1,key2,key3

# -----------------------------------------------------------------------------
# CORS (optional)
# Comma-separated list of allowed origins, or omit for smart defaults
# In dev: localhost:4000, localhost:5173
# In prod: https://$PHX_HOST
# Never use "*" in production
# -----------------------------------------------------------------------------

# CORS_ORIGINS=https://myapp.com,https://admin.myapp.com
