#!/bin/sh

# Sets and samples the release environment variable.
# The value will be persisted to both stdout and the config file.

export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=<%= @release.name %>@127.0.0.1

# The VPS is a shared KVM guest with steal time: an idle BEAM spinning its
# schedulers (the default busy-wait) burned ~10% of a core at 0.1% load.
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-+sbwt none +sbwtdcpu none +sbwtdio none}"
