# CSP is generated by StreamixWeb.Plugs.CSPNonce, which Sobelow cannot infer.
# The authenticated_stream pipeline only exposes read-only GET media routes,
# so CSRF protection doesn't apply there. Those exact findings are fingerprinted
# in .sobelow-skips; function-level false positives are documented at call sites.
[
  exit: :high,
  format: "compact",
  private: true,
  skip: true,
  threshold: :high
]
